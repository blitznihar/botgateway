<mxfile host="drawio" agent="Bot Gateway docs" version="24.0.0"><diagram id="conceptual" name="Conceptual architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Bot Gateway: conceptual architecture&lt;/b&gt;  ·  one control plane, many embedded bots, any site, any identity provider, any OpenAI-compatible agent" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1520" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;End users&lt;/b&gt;&lt;br&gt;guests · customers · employees · agents" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f1f5f9;strokeColor=#64748b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Admins&lt;/b&gt;&lt;br&gt;configure bots, review activity" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f1f5f9;strokeColor=#64748b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="875" y="70" width="240" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Host sites (any framework)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="300" height="700" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Public website / WordPress&lt;/b&gt;&lt;br&gt;guests, optional Auth0 login&lt;br&gt;&lt;font color='#64748b'&gt;&amp;lt;script src=…/widget.js data-bot-id&amp;gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor