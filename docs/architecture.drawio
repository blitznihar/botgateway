;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#fafaff;strokeColor=#6366f1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="160" width="760" height="820" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Middleware (Node runtime)&lt;/b&gt;  ·  CSP frame-ancestors per bot  ·  CORS allowlist  ·  admin Basic auth (ADMIN_PASSWORD)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe4e6;strokeColor=#f43f5e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="205" width="720" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Embed chat UI&lt;/b&gt;&lt;br&gt;/embed/[botId] (iframe)&lt;br&gt;sign-in state · Markdown&lt;br&gt;“reads this page”" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e0e7ff;strokeColor=#6366f1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="285" width="210" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Public API&lt;/b&gt;&lt;br&gt;/api/bots/:id (config)&lt;br&gt;/api/session (who am I)&lt;br&gt;/api/chat (gateway)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e0e7ff;strokeColor=#6366f1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="285" width="210" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Admin control plane&lt;/b&gt;&lt;br&gt;/ bots editor · /activity&lt;br&gt;import / export JSON&lt;br&gt;test connection · verify token" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e0e7ff;strokeColor=#6366f1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="890" y="285" width="210" height="110" as="geometry"/></mxCell><mxCell id="c16" value="Gateway core (lib/)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#a5b4fc;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="720" height="250" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Context&lt;/b&gt;&lt;br&gt;host-context allowlist&lt;br&gt;page snapshot sanitize&lt;br&gt;+ server-side redaction" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fef3c7;strokeColor=#f59e0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="220" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Prompt builder&lt;/b&gt;&lt;br&gt;system prompt + formatting&lt;br&gt;+ verified user + unverified&lt;br&gt;context + screen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fef3c7;strokeColor=#f59e0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="635" y="460" width="220" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;JWT verify via JWKS&lt;br&gt;(iss, aud, exp, signature)&lt;br&gt;claim mapping · anon IDs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fef3c7;strokeColor=#f59e0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="460" width="210" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Activity log&lt;/b&gt;&lt;br&gt;chats · loads · blocked · errors&lt;br&gt;user + screen excerpt" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fef3c7;strokeColor=#f59e0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="570" width="220" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;LLM client&lt;/b&gt;&lt;br&gt;OpenAI-compatible · per-bot&lt;br&gt;URL / key / model / params" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fef3c7;strokeColor=#f59e0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="635" y="570" width="220" height="80" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Dev IdP (test only)&lt;/b&gt;&lt;br&gt;/api/dev-idp/{entra|auth0}&lt;br&gt;ENABLE_DEV_IDP=true" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f1f5f9;strokeColor=#64748b;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="870" y="570" width="210" height="80" as="geometry"/></mxCell><mxCell id="c23" value="data/  (Docker volume, local JSON)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="700" width="720" height="260" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;bots.json&lt;/b&gt;&lt;br&gt;all bot configs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dcfce7;strokeColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="745" width="160" height="80" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;backups/&lt;/b&gt;&lt;br&gt;last 30 versions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dcfce7;strokeColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="575" y="745" width="160" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;activity.jsonl&lt;/b&gt;&lt;br&gt;bounded log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dcfce7;strokeColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="750" y="745" width="160" height="80" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;dev-idp-key.json&lt;/b&gt;&lt;br&gt;test signing key" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dcfce7;strokeColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="925" y="745" width="160" height="80" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Each bot (BotConfig)&lt;/b&gt;: theme · allowedDomains · identity (anonymous | JWT: issuer, audience, claims, required) · hostContext allowlist · pag